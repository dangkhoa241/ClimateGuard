# Copy to .env and fill in. Never commit .env.
BASETEN_API_KEY=your-baseten-key
MODEL_API_KEY=your-meta-model-api-key

# true = cheaper muse-spark-1.3-contributor (FAKE/dev data only — content may be used for training)
# false = standard muse-spark-1.3 (real user photos, demo)
USE_CONTRIBUTOR=true

# Optional: free EPA AirNow key (https://docs.airnowapi.org/account/request/).
# Without it, AQI comes from Open-Meteo (modeled, no key needed).
AIRNOW_API_KEY=

# NWS asks for a User-Agent with contact info
NWS_USER_AGENT=ClimateGuard/0.1 (you@example.com)

# local = JSON files in backend/.local (dev); dynamodb = AWS (set automatically in Lambda)
STORAGE=local
